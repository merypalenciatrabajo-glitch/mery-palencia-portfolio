{
  "name": "mery_palencia_portfolio",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.9.0 <12"
  },
  "scripts": {
    "dev": "vite --host",
    "dev:client": "pnpm --filter mery-palencia-portfolio-client dev",
    "dev:admin": "pnpm --filter mery-palencia-admin dev",
    "build": "pnpm run build:integrated",
    "build:integrated": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:client": "pnpm --filter mery-palencia-portfolio-client build",
    "build:admin": "pnpm --filter mery-palencia-admin build",
    "build:all": "pnpm run build:integrated && pnpm run build:client && pnpm run build:admin",
    "start": "node dist/index.js",
    "preview": "vite preview --host",
    "typecheck:root": "tsc --noEmit",
    "typecheck": "pnpm run typecheck:root && pnpm --filter mery-palencia-portfolio-client typecheck && pnpm --filter mery-palencia-admin typecheck",
    "check": "pnpm run typecheck",
    "test": "pnpm --filter mery-palencia-portfolio-client test && pnpm --filter mery-palencia-admin test",
    "test:server": "vitest --run --config vitest.server.config.ts",
    "test:firebase-rules": "firebase emulators:exec --project demo-mery-portfolio --only firestore,storage \"vitest --run tests/firebase.rules.test.ts --config vitest.firebase.config.ts\"",
    "preview:firebase:seed": "node scripts/seed-firebase-preview.mjs",
    "test:firebase-live": "node scripts/require-firebase-live-env.mjs && vitest --run --config vitest.firebase-live.config.ts",
    "check:frontend-secrets": "node scripts/check-frontend-secrets.mjs",
    "check:firebase-public": "node scripts/check-public-firebase.mjs",
    "check:vercel": "node scripts/validate-vercel-config.mjs",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run test:server && pnpm run build:all && pnpm run check:frontend-secrets && pnpm run check:vercel",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "axios": "^1.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "2.8.6",
    "embla-carousel-react": "^8.6.0",
    "express": "^4.21.2",
    "express-rate-limit": "8.6.1",
    "firebase": "^12.11.0",
    "firebase-admin": "14.2.0",
    "framer-motion": "^12.23.22",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.1.5",
    "next-themes": "^0.4.6",
    "react": "^19.2.1",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.64.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "streamdown": "^1.4.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "wouter": "^3.3.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@builder.io/vite-plugin-jsx-loc": "^0.1.1",
    "@firebase/rules-unit-testing": "5.0.1",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.3",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.21",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "add": "^2.0.6",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "firebase-tools": "15.25.1",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "supertest": "7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^7.1.7",
    "vite-plugin-manus-runtime": "^0.0.57",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@11.9.0",
  "volta": {
    "node": "24.18.0"
  }
}
