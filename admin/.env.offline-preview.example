# Local-only Android debug preview. These values target Firebase emulators and are not secrets.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-mery-portfolio.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-mery-portfolio
VITE_FIREBASE_STORAGE_BUCKET=demo-mery-portfolio.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:offline-preview
VITE_FIREBASE_EMULATORS=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_ADMIN_OFFLINE_PREVIEW=true
