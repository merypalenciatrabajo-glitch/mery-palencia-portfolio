# Trusted HTTPS directory containing signed Android APK releases.
# Example: https://github.com/OWNER/REPOSITORY/releases/download/
VITE_ANDROID_UPDATE_BASE_URL=

# Release tooling only. Never expose these values through VITE_ variables.
GITHUB_REPO=
GITHUB_TOKEN=
FIREBASE_ID_TOKEN=
