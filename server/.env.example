# Private server-only configuration. Never prefix these variables with VITE_.
# Prefer workload identity / GOOGLE_APPLICATION_CREDENTIALS when available.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alternative to the three variables above (use one approach, never both):
# FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON={"project_id":"","client_email":"","private_key":""}

PORT=3000

# Comma-separated origins in scheme://host[:port] format. No wildcard.
CORS_ALLOWED_ORIGINS=https://admin.example.com,https://portfolio.example.com

# Per-process limits. Use a shared store when running multiple server instances.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX=30

# Number of trusted reverse proxies (normally 1 on a managed platform).
TRUST_PROXY_HOPS=1

# HTTP timeouts in milliseconds. Headers must not exceed the request timeout.
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=5000

# Graceful shutdown deadline before remaining sockets are closed.
SHUTDOWN_TIMEOUT_MS=10000

# Readiness probes verify Firebase Auth and cache successful checks briefly.
FIREBASE_HEALTHCHECK_TIMEOUT_MS=3000
HEALTHCHECK_CACHE_MS=30000

# Production defaults to Firestore so limits are shared across instances.
# Development and tests default to memory.
RATE_LIMIT_STORE=firestore

# Read-only live Firebase verification. Use short-lived test tokens only.
# Never commit either token.
FIREBASE_TEST_EXPIRED_ID_TOKEN=
FIREBASE_TEST_REVOKED_ID_TOKEN=
